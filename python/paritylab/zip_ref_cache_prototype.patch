-//! Laboratory-only ZIP serializer: incomplete, does not support ZIP64 or
-//! directory entries, and hardcodes the Unix creator. Not production code.
 use docxtplrs::package::{crc32, Package};
+use std::collections::{HashMap, VecDeque};
+use std::sync::{Arc, Mutex, OnceLock};
+const CACHE_LIMIT: usize = 32 * 1024 * 1024;
+const ENTRY_LIMIT: usize = 64;
+#[derive(Default)]
+struct Cache { entries: HashMap<Arc<[u8]>, Arc<[u8]>>, order: VecDeque<Arc<[u8]>>, bytes: usize }
+static CACHE: OnceLock<Mutex<Cache>> = OnceLock::new();
+fn compress(data: Arc<[u8]>) -> Result<Arc<[u8]>, String> {
+    let cache = CACHE.get_or_init(|| Mutex::new(Cache::default()));
+    if let Some(value) = cache.lock().unwrap_or_else(|e| e.into_inner()).entries.get(data.as_ref()) { return Ok(value.clone()); }
+    let mut output=vec![0;zlib_rs_ref::compress_bound(data.len())];
+    let mut encoder=zlib_rs_ref::Deflate::new(-1,false,15);
+    encoder.compress(&data,&mut output,zlib_rs_ref::DeflateFlush::NoFlush).map_err(|e|format!("{e:?}"))?;
+    if encoder.total_in()!=data.len() as u64 { return Err("incomplete compression input".into()); }
+    let n=encoder.total_out() as usize;
+    let status=encoder.compress(&[],&mut output[n..],zlib_rs_ref::DeflateFlush::Finish).map_err(|e|format!("{e:?}"))?;
+    if status!=zlib_rs_ref::Status::StreamEnd { return Err("incomplete compression output".into()); }
+    output.truncate(encoder.total_out() as usize);
+    let compressed: Arc<[u8]> = output.into();
+    let size = data.len().saturating_add(compressed.len());
+    if size <= CACHE_LIMIT {
+        let mut guard=cache.lock().unwrap_or_else(|e|e.into_inner());
+        if let Some(value)=guard.entries.get(data.as_ref()){return Ok(value.clone());}
+        while guard.entries.len() >= ENTRY_LIMIT || guard.bytes+size > CACHE_LIMIT {
+            if let Some(key)=guard.order.pop_front(){if let Some(value)=guard.entries.remove(key.as_ref()){guard.bytes-=key.len()+value.len();}}else{break;}
+        }
+        guard.bytes+=size;guard.order.push_back(data.clone());guard.entries.insert(data,compressed.clone());
+    }
+    Ok(compressed)
+}
